@model ProyectoPROGEND.Models.PlanEntranamiento;
@{
    ViewData["Title"] = "Create";
}
<div class="container mt-5 fondo-planesentrena">
    <h2 class="mb-4 colo-titulo">Crear un Plan de entrenamiento</h2>
    <div asp-validation-summary="All" class="alert alert-danger alert-float"></div>
    <div class="form-container">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="form-floating mb-3">
                <input asp-for="Nombre" placeholder="" class="form-control">
                <label for="floatingInput">Nombre De Plan entrenamiento</label>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input type="file" name="imagen" class="form-control" />
                <label for="floatingInput" style="padding: 2%;">Introduzca una imagen</label>
                <span class="text-danger">@ViewData.ModelState["imagen"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="TipoEntrenamiento" placeholder="" class="form-control">
                <label for="floatingInput">Tipo de Entrenamiento (cardio, fuerza, HIIT, yoga, etc)</label>
                <span asp-validation-for="TipoEntrenamiento" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Equipamiento" placeholder="" class="form-control">
                <label for="floatingInput">Equipamiento necesario</label>
                <span asp-validation-for="Equipamiento" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Frecuencia" placeholder="" class="form-control">
                <label for="floatingInput">Frecuencia de entrenamiento (diaria, semanal, etc)</label>
                <span asp-validation-for="Frecuencia" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Objetivo" placeholder="" class="form-control">
                <label for="floatingInput">Objetivo del Plan (pérdida de peso, ganancia muscular, etc)</label>
                <span asp-validation-for="Objetivo" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Duracion" placeholder="" class="form-control">
                <label for="floatingInput">Duración del Plan</label>
                <span asp-validation-for="Duracion" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Dificultad" placeholder="" class="form-control">
                <label for="floatingInput">Rango de dificultad (del 1 al 5)</label>
                <span asp-validation-for="Dificultad" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Nivel" placeholder="" class="form-control">
                <label for="floatingInput">Nivel de entrenamiento (del 1 al 5)</label>
                <span asp-validation-for="Nivel" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <textarea class="form-control" placeholder="Leave a comment here" asp-for="Descripcion"
                    id="descripcionTextarea" style="height: 100px"></textarea>
                <label for="floatingTextarea2">Descripción</label>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="EdadMinRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Edad Mínima recomendada</label>
                <span asp-validation-for="EdadMinRecom" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="EdadMaxRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Edad Máxima Recomendada</label>
                <span asp-validation-for="EdadMaxRecom" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="PesoMinRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Peso Mínimo Recomendado</label>
                <span asp-validation-for="PesoMinRecom" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="PesoMaxRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Peso Máximo Recomendado</label>
                <span asp-validation-for="PesoMaxRecom" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="AlturaMinRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Altura Mínima Recomendada</label>
                <span asp-validation-for="AlturaMinRecom" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="AlturaMaxRecom" placeholder="" class="form-control">
                <label for="floatingTextarea2">Altura Máxima Recomendada</label>
                <span asp-validation-for="AlturaMaxRecom" class="text-danger"></span>
            </div>
            <button type="submit" value="Create" class="btn btn-primary">Guardar</button>

        </form>
    </div>

    <br>
    <div><br>
        <a class="btn btn-primary" asp-action="Index">Inicio</a>
    </div>
</div>